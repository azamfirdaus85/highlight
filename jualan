<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Promosi Basreng</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<style>
:root {
    --hitam: #140605;
    --merah: #e0200e;
    --oranye: #ff7a00;
    --kuning: #ffc21a;
    --krem: #fff1d6;
    --jeda: 2000ms;
}

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    margin: 0;
    min-height: 100vh;
    color: var(--krem);
    font-family: "Poppins", Arial, sans-serif;
    background: radial-gradient(1200px 600px at 50% -10%, #5a1204 0%, #140605 62%) fixed;
}

/* ---------- Panggung slide ---------- */
.stage {
    position: relative;
    width: calc(100% - 24px);
    max-width: 1100px;
    aspect-ratio: 16 / 9;
    margin: 24px auto 12px;
    overflow: hidden;
    border-radius: 20px;
    border: 2px solid rgba(255, 122, 0, 0.6);
    background: var(--hitam);
    box-shadow: 0 20px 60px rgba(224, 32, 14, 0.28);
    touch-action: pan-y;
}

.bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 4px;
    width: 0;
    z-index: 6;
    background: linear-gradient(90deg, var(--kuning), var(--merah));
}

.stage.auto .bar {
    animation: isi var(--jeda) linear forwards;
}

@keyframes isi {
    from { width: 0; }
    to { width: 100%; }
}

.slide {
    position: absolute;
    inset: 0;
    display: none;
    padding: 4% 6%;
    text-align: center;
    overflow: hidden;
    background: linear-gradient(160deg, #2a0803 0%, #7a1405 60%, #2a0803 100%);
}

.slide.active {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    animation: masuk 0.3s ease-out;
}

/* latar foto yang diburamkan */
.slide::before {
    content: "";
    position: absolute;
    inset: -30px;
    background-image: var(--bg, none);
    background-size: cover;
    background-position: center;
    filter: blur(18px) brightness(0.38) saturate(1.2);
    z-index: 0;
}

.slide > * {
    position: relative;
    z-index: 1;
}

@keyframes masuk {
    from { opacity: 0; transform: translateX(24px); }
    to { opacity: 1; transform: translateX(0); }
}

/* ---------- Teks ---------- */
.slide h1 {
    margin: 0 0 0.3em;
    font-family: "Anton", Impact, "Arial Black", sans-serif;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.08;
    font-size: clamp(26px, 5.2vw, 58px);
    color: var(--kuning);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.35);
}

.slide p {
    margin: 0.4em 0;
    font-size: clamp(14px, 1.8vw, 22px);
    line-height: 1.5;
    color: var(--krem);
}

/* ---------- Sampul ---------- */
.cover h1.kecil {
    font-size: clamp(22px, 4.6vw, 52px);
    color: var(--krem);
    margin: 0;
}

.cover h1.besar {
    font-size: clamp(44px, 11.5vw, 132px);
    margin: 0 0 0.12em;
    background: linear-gradient(180deg, #fff3a8 0%, #ffc21a 35%, #ff5a00 70%, #e0200e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    filter: drop-shadow(0 4px 14px rgba(255, 80, 0, 0.55));
}

.cover p {
    font-weight: 600;
}

.cover p.rasa {
    font-size: clamp(16px, 2.4vw, 28px);
    color: var(--kuning);
    margin-top: 0.8em;
}

/* ---------- Slide foto ---------- */
.foto.active {
    flex-direction: row;
    justify-content: center;
    gap: 5%;
}

.frame {
    height: 92%;
    max-width: 46%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.frame img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    border: 7px solid #fff8ea;
    border-radius: 6px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
    transform: rotate(-2deg);
}

.foto:nth-of-type(even) .frame img {
    transform: rotate(2deg);
}

.teks {
    flex: 1;
    max-width: 40%;
    text-align: left;
}

.teks h1::after {
    content: "";
    display: block;
    width: 64px;
    height: 5px;
    margin-top: 0.35em;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--oranye), var(--merah));
}

.ajakan {
    display: inline-block;
    margin-top: 0.6em;
    padding: 0.5em 1.1em;
    border-radius: 999px;
    font-family: "Anton", Impact, "Arial Black", sans-serif;
    font-size: clamp(16px, 2.6vw, 30px);
    letter-spacing: 0.03em;
    color: #3a0a02;
    background: linear-gradient(90deg, var(--kuning), var(--oranye));
}

/* ---------- Sensasi ---------- */
.sensasi .api {
    font-size: clamp(36px, 8vw, 90px);
    line-height: 1;
    margin-bottom: 0.2em;
}

.sensasi p {
    max-width: 30ch;
    font-size: clamp(15px, 2.4vw, 28px);
}

/* ---------- Harga ---------- */
.kartu-wrap {
    display: flex;
    gap: 20px;
    margin-top: 1.2em;
}

.kartu {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 220px;
    padding: 22px 30px;
    border-radius: 18px;
    border: 2px solid rgba(255, 194, 26, 0.5);
    background: rgba(255, 241, 214, 0.08);
}

.kartu.utama {
    border-color: var(--kuning);
    background: linear-gradient(160deg, #ff7a00, #e0200e);
    box-shadow: 0 10px 30px rgba(224, 32, 14, 0.45);
}

.kartu .rp {
    font-family: "Anton", Impact, "Arial Black", sans-serif;
    font-size: clamp(30px, 6vw, 64px);
    line-height: 1.1;
    color: var(--kuning);
}

.kartu.utama .rp {
    color: #fff;
}

.kartu .jml {
    font-size: clamp(14px, 1.9vw, 22px);
}

.badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 14px;
    border-radius: 999px;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 700;
    color: #3a0a02;
    background: var(--kuning);
}

/* ---------- Titik penanda ---------- */
.dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    z-index: 5;
    display: flex;
    justify-content: center;
    gap: 7px;
}

.dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 9px;
    background: rgba(255, 241, 214, 0.35);
    cursor: pointer;
    transition: width 0.2s, background 0.2s;
}

.dot.on {
    width: 24px;
    background: var(--kuning);
}

/* ---------- Tombol ---------- */
.status {
    margin: 8px 12px 0;
    text-align: center;
    font-size: 14px;
    color: var(--kuning);
}

.controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding: 10px 12px 34px;
}

button.tombol {
    padding: 13px 22px;
    border: 2px solid transparent;
    border-radius: 999px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    color: var(--krem);
    background: rgba(255, 241, 214, 0.1);
    border-color: rgba(255, 241, 214, 0.25);
    cursor: pointer;
    touch-action: manipulation;
    transition: transform 0.1s, background 0.15s;
}

button.tombol:active {
    transform: scale(0.96);
}

button.tombol.utama {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(90deg, var(--oranye), var(--merah));
}

button.tombol.aktif {
    color: #3a0a02;
    border-color: transparent;
    background: var(--kuning);
}

button:focus-visible {
    outline: 3px solid var(--kuning);
    outline-offset: 2px;
}

/* ---------- HP ---------- */
@media (max-width: 700px) {
    .stage {
        width: calc(100% - 16px);
        aspect-ratio: auto;
        height: 74vh;
        height: 74svh;
        margin: 8px auto 6px;
        border-radius: 16px;
    }

    .slide {
        padding: 6% 5% 9%;
    }

    .slide h1 {
        font-size: clamp(24px, 7.4vw, 34px);
    }

    .slide p {
        font-size: clamp(15px, 4.2vw, 19px);
    }

    .foto.active {
        flex-direction: column;
        gap: 12px;
    }

    .frame {
        height: 62%;
        max-width: 100%;
    }

    .teks {
        flex: none;
        max-width: 100%;
        text-align: center;
    }

    .teks h1::after {
        margin-left: auto;
        margin-right: auto;
    }

    .kartu-wrap {
        flex-direction: column;
        gap: 26px;
    }

    .kartu {
        min-width: 230px;
    }

    .cover h1.besar {
        font-size: clamp(48px, 17vw, 84px);
    }

    .controls button {
        flex: 1 1 44%;
    }
}

@media (prefers-reduced-motion: reduce) {
    .slide.active {
        animation: none;
    }

    .stage.auto .bar {
        animation: none;
    }
}
</style>
</head>

<body>

<div class="stage" id="stage">
<div class="bar"></div>

<section class="slide cover active">
<h1 class="kecil">KERIPIK BASRENG</h1>
<h1 class="besar">PEDAS MAMPUS!</h1>
<p class="rasa">Renyah • Gurih • Pedas</p>
<p>Siap Menggoyang Lidahmu!</p>
</section>

<section class="slide foto">
<div class="frame"><img src="data:image/jpeg;base64," alt="Poster Keripik Basreng Pedas Mampus"></div>
<div class="teks">
<h1>KENALAN DENGAN PRODUK KAMI</h1>
<p>Keripik Basreng Pedas Mampus</p>
</div>
</section>

<section class="slide sensasi">
<div class="api">🔥🌶️🔥</div>
<h1>RASAKAN SENSASI PEDASNYA!</h1>
<p>Camilan renyah untuk menemani waktu santaimu.</p>
</section>

<section class="slide harga">
<h1>HARGA SPESIAL</h1>
<div class="kartu-wrap">
<div class="kartu">
<span class="rp">Rp10.000</span>
<span class="jml">Untuk 1 bungkus</span>
</div>
<div class="kartu utama">
<span class="badge">Lebih hemat Rp2.000!</span>
<span class="rp">Rp18.000</span>
<span class="jml">Untuk 2 bungkus</span>
</div>
</div>
</section>

<section class="slide foto">
<div class="frame"><img src="data:image/jpeg;base64," alt="Tim penjual Keripik Basreng Pedas Mampus"></div>
<div class="teks">
<h1>TIM PENJUAL</h1>
<p>Terima kasih telah mendukung usaha kami!</p>
</div>
</section>

<section class="slide foto">
<div class="frame"><img src="data:image/jpeg;base64," alt="Dokumentasi transaksi dengan konsumen"></div>
<div class="teks">
<h1>DOKUMENTASI KONSUMEN</h1>
<p>Terima kasih atas pembelian dan dukungannya!</p>
</div>
</section>

<section class="slide foto">
<div class="frame"><img src="data:image/jpeg;base64," alt="Konsumen memegang Keripik Basreng Pedas Mampus"></div>
<div class="teks">
<h1>TERIMA KASIH!</h1>
<p>Keripik Basreng Pedas Mampus!</p>
<span class="ajakan">COBA SEKARANG! 🌶️</span>
</div>
</section>

<section class="slide foto">
<div class="frame"><img src="data:image/jpeg;base64," alt="Kebersamaan tim saat berjualan"></div>
<div class="teks">
<h1>KEBERSAMAAN DAN PENGALAMAN</h1>
<p>Pengalaman berharga dalam memasarkan produk.</p>
</div>
</section>

<section class="slide foto">
<div class="frame"><img src="data:image/jpeg;base64," alt="Konsumen mendukung produk kami"></div>
<div class="teks">
<h1>DUKUNG PRODUK KAMI!</h1>
<p>Terima kasih sudah menjadi bagian dari perjalanan kami.</p>
</div>
</section>

<section class="slide foto">
<div class="frame"><img src="data:image/jpeg;base64," alt="Sampai jumpa dari tim Pedas Mampus"></div>
<div class="teks">
<h1>SAMPAI JUMPA!</h1>
<p>KERIPIK BASRENG PEDAS MAMPUS!</p>
</div>
</section>

<div class="dots" id="dots"></div>
</div>

<p id="status" class="status">Otomatis: MATI</p>

<div class="controls">
<button id="btnPrev" class="tombol" type="button">❮ Sebelumnya</button>
<button id="btnNext" class="tombol" type="button">Selanjutnya ❯</button>
<button id="btnPlay" class="tombol utama" type="button">▶ Otomatis</button>
<button id="btnStop" class="tombol" type="button">⏸ Berhenti</button>
</div>

<script>
var stage = document.getElementById("stage");
var slides = [].slice.call(document.querySelectorAll(".slide"));
var indexSlide = 0;
var otomatisAktif = false;
var timerSlide = null;
var JEDA = 2000;

var btnPlay = document.getElementById("btnPlay");
var btnStop = document.getElementById("btnStop");
var teksStatus = document.getElementById("status");
var wadahDots = document.getElementById("dots");

stage.style.setProperty("--jeda", JEDA + "ms");

/* latar buram dari foto masing-masing slide */
slides.forEach(function (s) {
    var im = s.querySelector("img");
    if (im) {
        s.style.setProperty("--bg", 'url("' + im.src + '")');
    }
});
slides[0].style.setProperty("--bg", 'url("' + slides[1].querySelector("img").src + '")');

/* titik penanda */
var dots = slides.map(function (s, i) {
    var d = document.createElement("button");
    d.type = "button";
    d.className = "dot";
    d.setAttribute("aria-label", "Slide " + (i + 1));
    d.addEventListener("click", function () {
        tampil(i);
        jadwalkan();
    });
    wadahDots.appendChild(d);
    return d;
});

function ulangiBar() {
    stage.classList.remove("auto");
    void stage.offsetWidth;
    if (otomatisAktif) stage.classList.add("auto");
}

function perbaruiStatus() {
    teksStatus.textContent =
        "Otomatis: " + (otomatisAktif ? "AKTIF" : "MATI") +
        " • Slide " + (indexSlide + 1) + " dari " + slides.length;
    btnPlay.classList.toggle("aktif", otomatisAktif);
    btnStop.classList.toggle("aktif", !otomatisAktif);
    dots.forEach(function (d, i) {
        d.classList.toggle("on", i === indexSlide);
    });
    ulangiBar();
}

function tampil(n) {
    slides[indexSlide].classList.remove("active");
    indexSlide = (n + slides.length) % slides.length;
    slides[indexSlide].classList.add("active");
    perbaruiStatus();
}

function jadwalkan() {
    clearTimeout(timerSlide);
    if (!otomatisAktif) return;
    timerSlide = setTimeout(function () {
        if (!otomatisAktif) return;
        tampil(indexSlide + 1);
        jadwalkan();
    }, JEDA);
}

function mulaiOtomatis() {
    otomatisAktif = true;
    perbaruiStatus();
    jadwalkan();
}

function hentikanOtomatis() {
    otomatisAktif = false;
    clearTimeout(timerSlide);
    timerSlide = null;
    perbaruiStatus();
}

function berikutnya() {
    tampil(indexSlide + 1);
    jadwalkan();
}

function sebelumnya() {
    tampil(indexSlide - 1);
    jadwalkan();
}

document.getElementById("btnPrev").addEventListener("click", sebelumnya);
document.getElementById("btnNext").addEventListener("click", berikutnya);
btnPlay.addEventListener("click", mulaiOtomatis);
btnStop.addEventListener("click", hentikanOtomatis);

document.addEventListener("keydown", function (e) {
    if (e.key === "ArrowRight") berikutnya();
    if (e.key === "ArrowLeft") sebelumnya();
});

/* Geser jari di HP */
var mulaiX = 0;
var mulaiY = 0;

stage.addEventListener("touchstart", function (e) {
    mulaiX = e.touches[0].clientX;
    mulaiY = e.touches[0].clientY;
}, { passive: true });

stage.addEventListener("touchend", function (e) {
    var dx = e.changedTouches[0].clientX - mulaiX;
    var dy = e.changedTouches[0].clientY - mulaiY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) berikutnya(); else sebelumnya();
    }
}, { passive: true });

perbaruiStatus();   
</script>

</body>
</html>
